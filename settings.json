{
  "cleanupPeriodDays": 365,
  "env": {
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5[1m]"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "WebFetch",
      "WebSearch",
      "Bash(git add:*)",
      "Bash(git blame:*)",
      "Bash(git branch:*)",
      "Bash(git cat-file:*)",
      "Bash(git commit:*)",
      "Bash(git config --get:*)",
      "Bash(git config --list:*)",
      "Bash(git describe:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git grep:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git reflog:*)",
      "Bash(git remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git shortlog:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(git switch:*)",
      "Bash(git tag:*)",
      "Bash(cat:*)",
      "Bash(chmod:*)",
      "Bash(df:*)",
      "Bash(du:*)",
      "Bash(file:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(less:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(more:*)",
      "Bash(pwd:*)",
      "Bash(stat:*)",
      "Bash(tail:*)",
      "Bash(tree:*)",
      "Bash(awk:*)",
      "Bash(cut:*)",
      "Bash(echo:*)",
      "Bash(grep:*)",
      "Bash(sed -n:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(wc:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr view:*)",
      "Bash(taskherd:*)",
      "Bash(INTEGRATION_TEST=1 npx jest:*)",
      "Bash(npm run tsc:*)",
      "Bash(npm test:*)",
      "Bash(npx tsc:*)",
      "Bash(python3:*)",
      "Bash(whereis:*)",
      "Bash(which:*)",
      "Bash",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "NotebookEdit"
    ],
    "deny": [
      "Bash(git branch -D:*)",
      "Bash(git branch * -D)",
      "Bash(git branch * -D *)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git reset --hard:*)",
      "Bash(git reset * --hard)",
      "Bash(git reset * --hard *)",
      "Bash(nc:*)",
      "Bash(sudo:*)",
      "Bash(wget:*)"
    ],
    "ask": [
      "mcp__claude-in-chrome__javascript_tool"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.claude/hooks/taskherd-sync.py\" ]; then python3 \"$HOME/.claude/hooks/taskherd-sync.py\" prompt; fi",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if command -v kairan >/dev/null 2>&1; then kairan hook stop; else exit 0; fi",
            "timeout": 3900,
            "statusMessage": "kairan: 回答を待っています",
            "asyncRewake": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.claude/hooks/taskherd-sync.py\" ]; then python3 \"$HOME/.claude/hooks/taskherd-sync.py\" stop; fi",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh",
    "bgIsolation": "none"
  },
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline-command.sh",
    "padding": 0,
    "refreshInterval": 10
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "python3 ~/.claude/subagent-statusline.py"
  },
  "enabledPlugins": {
    "document-skills@anthropic-agent-skills": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-official.git"
      }
    },
    "scp-jp-plugins": {
      "source": {
        "source": "github",
        "repo": "SCP-JP/claude-plugins"
      }
    },
    "scp-jp-plugins-staff": {
      "source": {
        "source": "github",
        "repo": "SCP-JP/claude-plugins-staff"
      }
    }
  },
  "outputStyle": "ukwhatn-style",
  "language": "日本語",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "low"
    },
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5": {
      "effortLevel": "high"
    }
  },
  "autoCompactWindow": 450000,
  "promptSuggestionEnabled": false,
  "askUserQuestionTimeout": "never",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": true,
  "autoContinueAtUsageLimit": true,
  "teammateMode": "auto",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
