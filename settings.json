{
  "agentPushNotifEnabled": true,
  "askUserQuestionTimeout": "never",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "autoCompactEnabled": true,
  "autoCompactWindow": 450000,
  "autoContinueAtUsageLimit": true,
  "autoMemoryEnabled": false,
  "cleanupPeriodDays": 365,
  "editorMode": "normal",
  "enabledPlugins": {
    "document-skills@anthropic-agent-skills": true
  },
  "env": {
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5[1m]",
    "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1"
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-official.git"
      }
    },
    "scp-jp-plugins": {
      "source": {
        "repo": "SCP-JP/claude-plugins",
        "source": "github"
      }
    },
    "scp-jp-plugins-staff": {
      "source": {
        "repo": "SCP-JP/claude-plugins-staff",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/.claude/hooks/agent-model-required.py\" ]; then python3 \"$HOME/.claude/hooks/agent-model-required.py\"; fi",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Agent"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "\"$HOME/.local/bin/taskboard\" hook session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "asyncRewake": true,
            "command": "if command -v kairan >/dev/null 2>&1; then kairan hook stop; else exit 0; fi",
            "statusMessage": "kairan: 回答を待っています",
            "timeout": 3900,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "\"$HOME/.local/bin/taskboard\" hook stop",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "python3 \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/language-reminder.py\"",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  },
  "inputNeededNotifEnabled": true,
  "language": "日本語",
  "model": "claude-opus-5-5[1m]",
  "outputStyle": "ukwhatn-style",
  "permissions": {
    "allow": [
      "WebFetch",
      "WebSearch",
      "Bash(git add:*)",
      "Bash(git blame:*)",
      "Bash(git branch:*)",
      "Bash(git cat-file:*)",
      "Bash(git commit:*)",
      "Bash(git config --get:*)",
      "Bash(git config --list:*)",
      "Bash(git describe:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git grep:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git reflog:*)",
      "Bash(git remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git shortlog:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(git switch:*)",
      "Bash(git tag:*)",
      "Bash(cat:*)",
      "Bash(chmod:*)",
      "Bash(df:*)",
      "Bash(du:*)",
      "Bash(file:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(less:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(more:*)",
      "Bash(pwd:*)",
      "Bash(stat:*)",
      "Bash(tail:*)",
      "Bash(tree:*)",
      "Bash(awk:*)",
      "Bash(cut:*)",
      "Bash(echo:*)",
      "Bash(grep:*)",
      "Bash(sed -n:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(wc:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr view:*)",
      "Bash(taskherd:*)",
      "Bash(INTEGRATION_TEST=1 npx jest:*)",
      "Bash(npm run tsc:*)",
      "Bash(npm test:*)",
      "Bash(npx tsc:*)",
      "Bash(python3:*)",
      "Bash(whereis:*)",
      "Bash(which:*)",
      "Bash",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "NotebookEdit"
    ],
    "ask": [
      "mcp__claude-in-chrome__javascript_tool"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(git branch -D:*)",
      "Bash(git branch * -D)",
      "Bash(git branch * -D *)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git reset --hard:*)",
      "Bash(git reset * --hard)",
      "Bash(git reset * --hard *)",
      "Bash(nc:*)",
      "Bash(sudo:*)",
      "Bash(wget:*)"
    ]
  },
  "preferredNotifChannel": "auto",
  "promptSuggestionEnabled": false,
  "remoteControlAtStartup": true,
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "statusLine": {
    "command": "sh ~/.claude/statusline-command.sh",
    "padding": 0,
    "refreshInterval": 10,
    "type": "command"
  },
  "subagentStatusLine": {
    "command": "python3 ~/.claude/subagent-statusline.py",
    "type": "command"
  },
  "switchModelsOnFlag": true,
  "teammateMode": "auto",
  "theme": "light",
  "tui": "fullscreen",
  "worktree": {
    "baseRef": "fresh",
    "bgIsolation": "none"
  }
}
