{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|mcp__slack.*|mcp__google-workspace__.*_draft|mcp__github.*|mcp__atlassian.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/skill-gate.py\" --skills writing-code,writing-prose --namespace ukwhatn-skills",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__taskboard__(doc_publish|ask_user|review_request)|mcp__slack.*|mcp__google-workspace__.*_draft|mcp__github.*|mcp__atlassian.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/prose-check.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/skill-gate.py\" --skills writing-code,writing-prose --namespace ukwhatn-skills",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/skill-gate.py\" --skills writing-code,writing-prose --namespace ukwhatn-skills",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/prose-check.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/skill-gate.py\" --skills writing-code,writing-prose --namespace ukwhatn-skills",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/prose-check.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/skill-gate.py\" --skills writing-code,writing-prose --namespace ukwhatn-skills",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
